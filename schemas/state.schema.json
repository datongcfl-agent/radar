{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/datongcfl/radar/schemas/state.schema.json",
  "title": "radar run state",
  "type": "object",
  "required": ["schema_version", "run_id", "title", "created_at", "pack", "pack_version", "pack_sha256", "seeds_sha256", "mode", "options", "counts", "warnings", "radar_version", "radar_commit"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "title": {"type": "string"},
    "created_at": {"type": "string"},
    "pack": {"type": "string"},
    "pack_version": {"type": "string"},
    "pack_sha256": {"type": "string"},
    "seeds_sha256": {"type": "string"},
    "mode": {"enum": ["run", "scan"]},
    "base": {"type": ["string", "null"]},
    "since": {"type": "string"},
    "options": {"type": "object"},
    "counts": {
      "type": "object",
      "required": ["sources", "modules", "subsystems"],
      "properties": {
        "sources": {"type": "integer", "minimum": 0},
        "modules": {"type": "integer", "minimum": 0},
        "subsystems": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "radar_version": {"type": "string"},
    "radar_commit": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
